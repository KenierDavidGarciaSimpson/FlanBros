  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Token CSRF: el servidor lo entrega en la cookie XSRF-TOKEN; hay que devolverlo en la cabecera X-XSRF-TOKEN.",
          "const token = pm.cookies.get('XSRF-TOKEN');",
          "if (token) { pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: token }); }"
        ]
      }
    }
