{
  "info": {
    "name": "FlanBross API",
    "description": "Pruebas de la API de FlanBross. Orden: ejecutar la carpeta 0 primero y luego el resto en orden (Collection Runner). El script de coleccion agrega el token CSRF automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Preparacion (correr primero)",
      "item": [
        {
          "name": "GET /api/sesion (sin sesion: 401 y entrega la cookie XSRF-TOKEN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sesion"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('El servidor entrego la cookie XSRF-TOKEN', function () { pm.expect(pm.cookies.has('XSRF-TOKEN')).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
