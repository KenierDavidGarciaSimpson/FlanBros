              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_cliente\": 2,\n  \"direccion_entrega\": \"Bocagrande, Calle 5 #2-15\",\n  \"observaciones\": \"Prueba Postman\",\n  \"metodo_pago\": \"tarjeta\",\n  \"items\": [\n    {\n      \"id_producto\": 3,\n      \"cantidad\": 2,\n      \"precio_unitario\": 8500\n    },\n    {\n      \"id_producto\": 10,\n      \"cantidad\": 1,\n      \"precio_unitario\": 19000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('exito = true', function () { pm.expect(pm.response.json().exito).to.eql(true); });",
                  "const d = pm.response.json().datos;",
                  "pm.collectionVariables.set('pedidoId', d.id_pedido);",
                  "pm.test('Trae numero de factura FAC-', function () { pm.expect(d.numero_factura).to.match(/^FAC-/); });",
                  "pm.test('Total = subtotal + IVA 8%', function () { pm.expect(d.total).to.eql(Math.round(d.subtotal * 1.08)); });"
                ]
              }
            }
          ]
        },
